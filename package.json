{
  "name": "@beckchiang/dsh-doctor",
  "description": "DeepSeek Harness diagnostic, repair, and rollback plugin with a settings panel and a five-rung repair ladder. Fork of @jorinyang/dsh-doctor: keeps dsh_doctor / dsh_doctor_fix / dsh_doctor_rollback, the Cordis runtime service and the CLI, and adds a browser-side 体检 panel.",
  "version": "0.4.0",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "panel",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "scripts",
    "DESIGN.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run typecheck && pnpm run build",
    "test": "node test/smoke.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "diagnostic",
    "doctor",
    "repair",
    "repair-ladder",
    "settings-panel",
    "cli",
    "agent",
    "dsh-doctor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeckChiang/dsh-doctor.git"
  },
  "homepage": "https://github.com/jorinyang/dsh-doctor",
  "bugs": {
    "url": "https://github.com/BeckChiang/dsh-doctor/issues"
  },
  "upstream": {
    "repository": "https://github.com/jorinyang/dsh-doctor",
    "package": "@jorinyang/dsh-doctor",
    "version": "0.3.2",
    "commit": "79418687"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../dsh-visualize/node_modules/@deepseek-ai/cordis",
    "@deepseek-ai/dsh-tools": "link:../dsh-visualize/node_modules/@deepseek-ai/dsh-tools",
    "@deepseek-ai/schemastery": "3.18.1-rc.1",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "bin": {
    "dsh-doctor": "lib/cli.bundle.js"
  }
}
